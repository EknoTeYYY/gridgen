# App
NODE_ENV=development
APP_DOMAIN=studio.localhost
APP_PORT=8080

# Postgres
POSTGRES_USER=studio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=studio
DATABASE_URL=postgresql://studio:change-me@postgres:5432/studio

# Redis
REDIS_URL=redis://redis:6379

# Auth — gere com: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# LLM (Fase 2)
ANTHROPIC_API_KEY=

# Render
CHROME=/usr/bin/chromium
OUTPUT_DIR=/data/output

# Cifra em repouso qualquer token OAuth de integração de terceiro (ex.:
# publicação automática por rede, Fase 5) — gere com: openssl rand -hex 32
ENCRYPTION_KEY=

# Banco de imagens de referência (Pexels — grátis, sem aprovação prévia):
# https://www.pexels.com/api/
PEXELS_API_KEY=

# E-mail transacional (convite de Conta) — https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
# URL pública do `web`, usada pra montar o link de convite.
WEB_APP_URL=http://localhost:3000

# Caddy (deploy)
CADDY_ACME_EMAIL=
