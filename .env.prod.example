# .env de PRODUÇÃO — vive só na VM compartilhada (/opt/gridgen/.env), nunca
# commitado. Gere os segredos NA PRÓPRIA VM, nunca em chat/log:
#
#   cp .env.prod.example .env && chmod 600 .env
#   sed -i "s|^JWT_SECRET=.*|JWT_SECRET=$(openssl rand -hex 32)|" .env
#   sed -i "s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$(openssl rand -hex 24)|" .env
#   sed -i "s|^ENCRYPTION_KEY=.*|ENCRYPTION_KEY=$(openssl rand -hex 32)|" .env
#   nano .env   # ANTHROPIC_API_KEY, PEXELS_API_KEY, RESEND_API_KEY

NODE_ENV=production

# Postgres (interno, só a rede gridgen-backend enxerga)
POSTGRES_USER=gridgen
POSTGRES_PASSWORD=
POSTGRES_DB=gridgen

# Auth — gere na VM com: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# IA (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Cifra em repouso de token OAuth de integração de terceiro (Fase 5) —
# gere na VM com: openssl rand -hex 32
ENCRYPTION_KEY=

# Banco de imagens de referência — https://www.pexels.com/api/
PEXELS_API_KEY=

# E-mail transacional (convite de Conta, aviso de publicação) —
# https://resend.com/api-keys — domínio de envio precisa estar verificado no
# Resend antes (Settings → Domains → adicionar gridgen.com.br + registros
# DNS que eles pedem). Até isso acontecer, usar o remetente de teste
# onboarding@resend.dev (só entrega pro próprio dono da conta Resend).
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# URL pública real do produto — usada pra montar o link de convite enviado
# por e-mail. Só ativar de fato (trocar aqui + reiniciar) depois que o DNS
# do domínio estiver propagado, senão o link fica sem TLS válido ainda.
WEB_APP_URL=https://gridgen.com.br
