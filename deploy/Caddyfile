# Este arquivo NÃO roda em lugar nenhum — o Gridgen não tem Caddy próprio na
# VM compartilhada da eknotech (Magalu). Quem possui as portas 80/443 do host
# é o `gedfy-caddy`, do repositório do Gedfy.
#
# Isto é só REFERÊNCIA: o bloco abaixo precisa ser colado no
# `deploy/Caddyfile` do repositório do Gedfy (fonte de verdade, montada em
# gedfy-caddy:/etc/caddy/Caddyfile) e recarregado sem downtime com:
#
#   docker exec gedfy-caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
#
# Domínio já registrado: gridgen.com.br. Só ativar de fato (colar no Gedfy +
# reload) depois que o DNS (registros A abaixo) estiver propagado — o Caddy
# tenta emitir certificado Let's Encrypt na hora do reload, e isso falha se o
# domínio ainda não resolver pro IP da VM.
#
#   A   @     201.54.11.5
#   A   api   201.54.11.5

gridgen.com.br {
    encode gzip zstd
    reverse_proxy gridgen-web:3000
}

api.gridgen.com.br {
    encode gzip zstd
    reverse_proxy gridgen-api:8080
}
